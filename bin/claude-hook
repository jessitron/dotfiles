#!/bin/bash

LOG_FILE=~/temp/claudeDoesAThing.txt

say -v Cellos "derp" 

input=$(cat)

echo "---------- $(date) -----------" >> $LOG_FILE
echo $input >> $LOG_FILE

if [ -z "$CLAUDE_CODE_OUTPUT_HONEYCOMB_API_KEY" ]; then
  echo "HONEYCOMB_API_KEY not set, not sending telemetry" >> $LOG_FILE
  exit 1
fi

export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=$CLAUDE_CODE_OUTPUT_HONEYCOMB_API_KEY"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io:443"
export OTEL_SERVICE_NAME=claude-hooks

echo $input | $(dirname $0)/send_otlp_log.sh

