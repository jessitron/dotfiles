#!/bin/zsh
# Renders starship.toml.tmpl into a real config, swapping in the 7 rainbow-
# chain colors from env vars (falling back to the defaults baked into
# starship.toml). Prints the path to the rendered file on stdout — caller
# sets STARSHIP_CONFIG to it, e.g. from a .be file:
#
#   export STARSHIP_TIME_BG="#1d2021"
#   export STARSHIP_DIR_BG="#5f5fd7"
#   export STARSHIP_CONFIG="$(~/code/jessitron/dotfiles/bin/starship-colors)"
#
# Vars not set keep their default (the current starship.toml colors), so a
# .be file only needs to set the ones it's overriding.

set -euo pipefail

TEMPLATE="$HOME/code/jessitron/dotfiles/starship.toml.tmpl"
CACHE_DIR="${TMPDIR:-/tmp}/starship-colors"
mkdir -p "$CACHE_DIR"

: "${STARSHIP_TIME_BG:=#1d2021}"
: "${STARSHIP_DIR_BG:=#FFAA00}"
: "${STARSHIP_DIR_FG:=#1d2021}"
: "${STARSHIP_BRANCH_BG:=#10aa20}"
: "${STARSHIP_BRANCH_FG:=#1d2021}"
: "${STARSHIP_STATUS_BG:=#00AACC}"
: "${STARSHIP_STATUS_FG:=#1d2021}"

key="$STARSHIP_TIME_BG|$STARSHIP_DIR_BG|$STARSHIP_DIR_FG|$STARSHIP_BRANCH_BG|$STARSHIP_BRANCH_FG|$STARSHIP_STATUS_BG|$STARSHIP_STATUS_FG"
hash=$(echo "$key" | md5)
out="$CACHE_DIR/$hash.toml"

if [[ ! -e "$out" ]]; then
  sed \
    -e "s|@@TIME_BG@@|$STARSHIP_TIME_BG|g" \
    -e "s|@@DIR_BG@@|$STARSHIP_DIR_BG|g" \
    -e "s|@@DIR_FG@@|$STARSHIP_DIR_FG|g" \
    -e "s|@@BRANCH_BG@@|$STARSHIP_BRANCH_BG|g" \
    -e "s|@@BRANCH_FG@@|$STARSHIP_BRANCH_FG|g" \
    -e "s|@@STATUS_BG@@|$STARSHIP_STATUS_BG|g" \
    -e "s|@@STATUS_FG@@|$STARSHIP_STATUS_FG|g" \
    "$TEMPLATE" > "$out"
fi

echo "$out"
