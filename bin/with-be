#!/usr/bin/env bash
# Run a command with the environment from .be at the root of the current repo.
# Usage: with-be <command> [args...]   e.g. with-be ./run
# A worktree has no .be (it's git-excluded), so this falls back to the main checkout's.
set -euo pipefail

die() { echo "with-be: $*" >&2; exit 1; }

[ $# -gt 0 ] || die "usage: with-be <command> [args...]"

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git repo"
be="$root/.be"
if [ ! -f "$be" ]; then
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  be="$(dirname "$common")/.be"
fi
[ -f "$be" ] || die "no .be in $root or the main checkout"

set -a
# shellcheck disable=SC1090
source "$be"
set +a
exec "$@"
