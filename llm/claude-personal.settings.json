{
  "model": "opus",
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "~/code/jessitron/dotfiles/bin/claude-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "iterate-on-docs@iterate-on-docs": true
  },
  "extraKnownMarketplaces": {
    "tronijess-skills": {
      "source": {
        "source": "directory",
        "path": "/Users/jessitron/code/jessitron/tronijess-skills"
      }
    },
    "iterate-on-docs": {
      "source": {
        "source": "directory",
        "path": "/Users/jessitron/code/jessitron/iterate-on-docs"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(source .be)"
    ]
  },
  "effortLevel": "medium",
  "theme": "dark",
  "worktree": {
    "baseRef": "head"
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Any command that recursively scans, searches, or walks filesystem root. These trigger macOS permission popups for every third-party app's folder (Dropbox, etc.)."
    ]
  }
}
