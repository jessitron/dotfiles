{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-notification-hook"
          },
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          },
          {
            "type": "command",
            "command": "~/bin/claude-approval-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "honeycomb@honeycomb-plugins": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "honeycomb-plugins": {
      "source": {
        "source": "github",
        "repo": "honeycombio/agent-skill"
      }
    },
    "agents-observe": {
      "source": {
        "source": "github",
        "repo": "simple10/agents-observe"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "disabledMcpServers": [
    "claude.ai Slack",
    "claude.ai Asana",
    "claude.ai Honeycomb",
    "claude.ai Honeycomb Dogfood",
    "claude.ai Context7"
  ],
  "preferences": {
    "tmuxSplitPanes": true
  },
  "theme": "dark-daltonized"
}
